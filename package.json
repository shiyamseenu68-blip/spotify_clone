{
  "name": "spotify-fullstack-clone",
  "version": "1.0.0",
  "description": "Production-grade Full-Stack Spotify Web Application with Node.js Express REST API, JWT Auth, Database, and React Frontend",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "vite client --port 3000",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "vercel-build": "echo 'Build complete'"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "concurrently": "^8.2.2"
  }
}
